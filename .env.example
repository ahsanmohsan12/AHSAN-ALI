# GEMINI_API_KEY: Required for server-side Gemini AI API calls (SEO, video analysis, thumbnails, TTS, chat).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / APP_BASE_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
APP_BASE_URL="http://localhost:3000"

# GOOGLE OAUTH & WORKSPACE: Client-side OAuth is managed via Firebase Auth & Google Identity Services.
# Optional server-side configuration if deploying standalone:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# YOUTUBE DATA API v3: Optional public API key for unauthenticated public video discovery fallback
YOUTUBE_API_KEY=""

# GOOGLE DRIVE INTEGRATION: Root folder ID for ViralMint/ hierarchy (auto-created if empty)
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# COLAB WORKER & SESSION SECURITY: Shared secret for authenticating Tesla T4 Colab worker heartbeats and checkpoints
WORKER_SHARED_SECRET="vm_worker_t4_default_dev_secret"
APP_SESSION_SECRET="vm_session_csrf_protection_secret"
